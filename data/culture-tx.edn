#:culture{:id "dma.dish.callaloo", :name "Callaloo", :country "DMA", :kind :dish, :summary "Soup of leafy greens (in Dominica primarily taro/dasheen bush), coconut milk and sometimes salted meat or seafood; one of the national dishes of Dominica (and of Trinidad and Tobago), found all around the Caribbean.", :url "https://en.wikipedia.org/wiki/Callaloo", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Mountain_chicken", :id "dma.dish.mountain-chicken", :kind :dish, :name-local "Crapaud", :country "DMA", :retrieved-at "2026-07-17", :summary "Meaty legs of the crapaud frog of Dominica and Montserrat, cooked in traditional Dominican dishes and until recently the country's national dish; the critically endangered species is now protected and near-extinct in the wild.", :name "Mountain chicken", :url-provenance :wikipedia-en}
#:culture{:id "dma.dish.green-fig-and-saltfish", :name "Green fig and saltfish", :country "DMA", :kind :dish, :summary "Dish of green bananas and salted codfish seasoned with onions, peppers and garlic, part of Dominica cuisine.", :url "https://en.wikipedia.org/wiki/Dominica_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "dma.beverage.kubuli", :name "Kubuli beer", :country "DMA", :kind :beverage, :summary "Dominica brews its beer under the Kubuli label.", :url "https://en.wikipedia.org/wiki/Dominica_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "dma.beverage.cacao-tea", :name "Cacao tea", :country "DMA", :kind :beverage, :summary "Drink commonly served with breakfasts in Dominica, made by boiling cocoa sticks with cinnamon and bay leaves.", :url "https://en.wikipedia.org/wiki/Dominica_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "dma.festival.world-creole-music-festival", :name "World Creole Music Festival", :country "DMA", :kind :festival, :summary "Annual three-day music festival hosted on the island of Dominica during the final weekend in October, begun in 1997 during International Creole Month around the island's Independence celebrations.", :url "https://en.wikipedia.org/wiki/World_Creole_Music_Festival", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "dma.heritage.morne-trois-pitons", :name "Morne Trois Pitons National Park", :country "DMA", :kind :heritage, :summary "National park in Dominica established in July 1975, the first legally established in the country, featuring the Boiling Lake and the Valley of Desolation; a UNESCO World Heritage Site since 1997.", :url "https://en.wikipedia.org/wiki/Morne_Trois_Pitons_National_Park", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
